rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: verifica que el usuario autenticado sea admin ──
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ── Usuarios ──
    match /users/{uid} {
      // Cada usuario puede leer su propio doc
      allow read: if request.auth != null && request.auth.uid == uid;

      // Puede crear su propio doc (registro), pero solo con role=usuario y puedeVerPrecios=false
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == "usuario"
        && request.resource.data.puedeVerPrecios == false;

      // Puede actualizar su propio doc, pero NO puede cambiar role ni puedeVerPrecios
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["puedeVerPrecios", "role"]);

      // Admin puede leer todos los docs (get y list/query)
      allow read: if isAdmin();

      // Admin solo puede modificar puedeVerPrecios
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["puedeVerPrecios"]);
    }

    // ── Máquinas: lectura pública, escritura solo admin ──
    match /maquinas/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Eventos: lectura pública, escritura solo admin ──
    match /eventos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Insumos: lectura pública, escritura solo admin ──
    match /insumos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Contactos: cualquiera puede crear, solo admin puede leer ──
    match /contactos/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Newsletter: cualquiera puede crear, solo admin puede leer ──
    match /newsletter/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Presupuestos: cualquiera puede crear, solo admin puede leer ──
    match /presupuestos/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Sorteo config: lectura pública, escritura solo admin ──
    match /sorteo_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Sorteo participantes: lectura pública (aprobados visibles), crear autenticado, admin gestiona ──
    match /sorteo_participantes/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }
  }
}
